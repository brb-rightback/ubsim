# ExtGen (GiBUU/NuWro) NuMI RHC samples: extra PPFX universes, pass 4 of 5.
# The PPFX part of run_eventweight_microboone_sept24_extragenieall_4_numi_rhc.fcl
# (same process name and seeds) without the GENIE "All" universes, run on top of
# run_eventweight_microboone_sept24_numi_rhc_no_xs.fcl. That fcl gives ppfx_cv, the first
# 100 PPFX universes and the reinteraction universes; passes 1-5 add 100 PPFX universes each,
# for the 600 of the GENIE NuMI overlays (ppfx_all in the PeLEE ntuple, which reads the
# processes EventWeightSep24ExtraGENIE1-5). The individual ppfx_* knobs of each pass are
# also stored.
# Run after run_redk2nu_rhc.fcl: PPFX needs the Dk2Nu that the overlay mixer drops.

#include "run_eventweight_microboone_sept24_numi_rhc_no_xs.fcl"

process_name: EventWeightSep24ExtraGENIE4

outputs: {
 out1: {
   module_type: RootOutput
   fileName: "%ifb_extrappfx4.root"
   dataTier: "detector-simulated"
   compressionLevel: 1
 }
}

physics.producers.eventweightSep24.weight_functions: [ ppfx_ms, ppfx_mipppi, ppfx_mippk, ppfx_thinmes, ppfx_thinpi,
    ppfx_other, ppfx_thinnpi, ppfx_totabs, ppfx_targatt, ppfx_thinna,
    ppfx_think, ppfx_thinn ]

# PPFX seeds as in the extragenieall_4 fcl (there the ppfx_thinnpi seed is set as
# "ppfx_thinnp", so it is not applied; here it is)
physics.producers.eventweightSep24.ppfx_mipppi.random_seed: 4051
physics.producers.eventweightSep24.ppfx_mippk.random_seed: 88951
physics.producers.eventweightSep24.ppfx_thinmes.random_seed: 47114
physics.producers.eventweightSep24.ppfx_thinpi.random_seed: 91010
physics.producers.eventweightSep24.ppfx_other.random_seed: 12912
physics.producers.eventweightSep24.ppfx_thinnpi.random_seed: 4868
physics.producers.eventweightSep24.ppfx_totabs.random_seed: 9663
physics.producers.eventweightSep24.ppfx_targatt.random_seed: 4223
physics.producers.eventweightSep24.ppfx_thinna.random_seed: 1601
physics.producers.eventweightSep24.ppfx_think.random_seed: 1501
physics.producers.eventweightSep24.ppfx_thinn.random_seed: 828
physics.producers.eventweightSep24.ppfx_ms.random_seed: 884
