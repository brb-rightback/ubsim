# ExtGen (GiBUU/NuWro) NuMI FHC samples: extra PPFX universes, pass 1 of 5.
# The PPFX part of run_eventweight_microboone_sept24_extragenieall_1_numi_fhc.fcl
# (same process name and seeds) without the GENIE "All" universes, run on top of
# run_eventweight_microboone_sept24_numi_fhc_no_xs.fcl. That fcl gives ppfx_cv, the first
# 100 PPFX universes and the reinteraction universes; passes 1-5 add 100 PPFX universes each,
# for the 600 of the GENIE NuMI overlays (ppfx_all in the PeLEE ntuple, which reads the
# processes EventWeightSep24ExtraGENIE1-5). The individual ppfx_* knobs of each pass are
# also stored.
# Run after run_redk2nu_fhc.fcl: PPFX needs the Dk2Nu that the overlay mixer drops.

#include "run_eventweight_microboone_sept24_numi_fhc_no_xs.fcl"

process_name: EventWeightSep24ExtraGENIE1

outputs: {
 out1: {
   module_type: RootOutput
   fileName: "%ifb_extrappfx1.root"
   dataTier: "detector-simulated"
   compressionLevel: 1
 }
}

physics.producers.eventweightSep24.weight_functions: [ ppfx_ms, ppfx_mipppi, ppfx_mippk, ppfx_thinmes, ppfx_thinpi,
    ppfx_other, ppfx_thinnpi, ppfx_totabs, ppfx_targatt, ppfx_thinna,
    ppfx_think, ppfx_thinn ]

# PPFX seeds as in the extragenieall_1 fcl (there the ppfx_thinnpi seed is set as
# "ppfx_thinnp", so it is not applied; here it is)
physics.producers.eventweightSep24.ppfx_mipppi.random_seed: 3451
physics.producers.eventweightSep24.ppfx_mippk.random_seed: 86551
physics.producers.eventweightSep24.ppfx_thinmes.random_seed: 46514
physics.producers.eventweightSep24.ppfx_thinpi.random_seed: 90410
physics.producers.eventweightSep24.ppfx_other.random_seed: 12312
physics.producers.eventweightSep24.ppfx_thinnpi.random_seed: 4268
physics.producers.eventweightSep24.ppfx_totabs.random_seed: 9063
physics.producers.eventweightSep24.ppfx_targatt.random_seed: 3623
physics.producers.eventweightSep24.ppfx_thinna.random_seed: 1001
physics.producers.eventweightSep24.ppfx_think.random_seed: 1101
physics.producers.eventweightSep24.ppfx_thinn.random_seed: 228
physics.producers.eventweightSep24.ppfx_ms.random_seed: 284
