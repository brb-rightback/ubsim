<?xml version="1.0" encoding="ISO-8859-1"?>

<!--
ExtGen tune for NuWro 25.11 (ubsim/ExtGen).

GENIE only selects the neutrino, target, current (CC/NC), energy and vertex
using NuWro's total cross sections; the final state is generated by NuWro
(nuwro_extgen) and merged in by ExtGenMerge.
-->

<tune_generator_list>
  <param_set name="Default">
     <param type="int" name="NGenerators">   1                                     </param>
     <param type="alg" name="Generator-0">   genie::EventGenerator/ExtGenRequest   </param>
  </param_set>
</tune_generator_list>
