<?xml version="1.0"?>

<!-- Production template: edit the entities marked SET_ME.
     NEUT 6.2.3 (tag 6.2.3, 2b3d4312, unmodified) with ExtGen's driver neut_extgen (md5 98534fe5),
     card e2c4c81f (extgen_neut_card.sh: Nieves QE with M_A = 1.05 GeV, NEUT defaults otherwise)
     and tables neut_6_2_3_e2c4c81f in uboonedata.

     ExtGen NEUT overlay, BNB run 4c: production through reco1.
     The NEUT counterpart of extgen_gibuu_bnb_run4c_reco1.xml; only the
     generator part differs. Each job takes one run-4c EXT file and runs
       extgen_neut_grid_init.sh, nevents auto (initscript): setup, checks:
                                  NEUT tarball and its e26 environment,
                                  tables, seeds
       extgen_ext_copy.fcl        copies the EXT file into the job; its
                                  endscript extgen_neut_grid_continue.sh
                                  counts its events N and runs steps A-D
                                  (N GENIE requests with NEUT cross sections,
                                  tune NE06_02a_00_000; NEUT final states;
                                  merge)
                                  -> genfile.root.local with N events
       extgen_overlay_SimInfoMixer.fcl, then the standard run-4c overlay chain:
       g4, detsim, overlay, reco1 stages 1a/1b/1c.

     NEUT runs with the e26 ROOT of its build, set up from the
     larsoft CVMFS repository (extgen_neut_run.sh), hence the extra
     condor requirement.

     Before submitting:
       * set the SET_ME entities: numjobs is one job per EXT file;
       * release must be a uboonecode release whose uboonedata has the tables;
       * copy the NEUT tarball neut_tar from /pnfs/uboone/persistent/users/uboonepro/ExtGen
         (the stored copy: too large for uboonedata) to your resilient directory extgen_dir;
         jobsub -f takes it from there and the job checks its md5.
     Every job keeps its seeds, requests, served events and the in-job cross
     section check (V4) in its log tarball.
-->

<!DOCTYPE project [
<!ENTITY release      "v08_00_00_98">
<!ENTITY qual         "e17:prof">
<!ENTITY user         ""> <!-- SET_ME -->
<!ENTITY name         "">  <!-- SET_ME -->
<!ENTITY ext_samdef   "">  <!-- SET_ME -->
<!ENTITY extgen_dir   "">  <!-- SET_ME: resilient directory with a copy of the tarball, e.g. /pnfs/uboone/resilient/users/USER/extgen -->
<!ENTITY neut_tar     "neut_6_2_3_e2c4c81f.tar.gz">  <!-- stored in /pnfs/uboone/persistent/users/uboonepro/ExtGen -->
<!ENTITY neut_md5     "4b964fdab0139d6fec5d628049588be6">  <!-- md5sum of the tarball (NEUT 2b3d4312, neut_extgen 98534fe5, card e2c4c81f) -->
<!ENTITY tables       "genie/neut/neut_6_2_3_e2c4c81f">  <!-- extgen_neut_tables.sh -b 4000 -->
<!ENTITY numjobs      "">   <!-- SET_ME -->
]>

<job>

<project name="&name;_reco1">

  <numevents>-1</numevents>
  <os>SL7</os>
  <resource>DEDICATED,OPPORTUNISTIC</resource>

  <larsoft>
    <tag>&release;</tag>
    <qual>&qual;</qual>
  </larsoft>

  <check>1</check>
  <copy>0</copy>
  <version>prod_&release;</version>

  <stage name="reco1">

    <inputdef>&ext_samdef;</inputdef>

    <!-- setup for steps A-D; the tables are read from uboonedata, the tarball comes with jobsub -f -->
    <initscript>extgen_neut_grid_init.sh --stepa-fcl extgen_requests_neut_bnb.fcl --nevents auto --neut-tarball &extgen_dir;/&neut_tar; --neut-md5 &neut_md5; --tables &tables; --soft-fail</initscript>

    <!-- EXT file into the job, then steps A-D with N = its events -->
    <fcl>extgen_ext_copy.fcl
      <endscript>extgen_neut_grid_continue.sh</endscript>
    </fcl>
    <fcl>extgen_overlay_SimInfoMixer.fcl</fcl>
    <fcl>wirecell_g4_uboone.fcl</fcl>
    <fcl>wirecell_detsim_overlay_uboone.fcl</fcl>
    <fcl>standard_overlay_uboone.fcl</fcl>
    <fcl>reco_uboone_mcc9_8_driver_overlay_stage1a.fcl</fcl>
    <fcl>reco_uboone_mcc9_8_driver_overlay_stage1b.fcl</fcl>
    <fcl>reco_uboone_mcc9_8_driver_overlay_stage1c.fcl</fcl>

    <outdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/reco1</outdir>
    <logdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/reco1</logdir>
    <workdir>/pnfs/uboone/resilient/users/&user;/work/&release;/&name;/reco1</workdir>
    <bookdir>/pnfs/uboone/resilient/users/&user;/book/&release;/&name;/reco1</bookdir>

    <maxfilesperjob>1</maxfilesperjob>
    <numjobs>&numjobs;</numjobs>
    <memory>4000</memory>
    <disk>35GB</disk>
    <prestagefraction>0.99</prestagefraction>
    <datatier>reconstructed</datatier>
    <jobsub>--expected-lifetime=12h -e IFDH_CP_UNLINK_ON_ERROR=1 --subgroup=prod --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)&amp;&amp;(TARGET.HAS_CVMFS_uboone_osgstorage_org==true)&amp;&amp;(TARGET.HAS_CVMFS_larsoft_opensciencegrid_org==true)' -f &extgen_dir;/&neut_tar;</jobsub>
    <jobsub_start>--subgroup=prod --expected-lifetime=12h --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)'</jobsub_start>
  </stage>

  <filetype>overlay</filetype>
  <runtype>physics</runtype>

</project>

</job>
