<?xml version="1.0"?>

<!-- ExtGen GiBUU overlay, BNB run 4c: first grid test (P4).
     Each job: extgen_gibuu_grid_init.sh (steps A-D: GENIE requests, GiBUU,
     merge -> genfile.root.local), then the mixer onto one EXT file, then g4.
     Production adds the usual detsim / overlay / reco1 fcls after g4.

     Tables: the GiBUU spline, sigma and Max set &tables; in uboonedata
     (genie/gibuu/, found along FW_SEARCH_PATH), made with the same GiBUU
     build as &gibuu_tar; and the job card script installed with ubsim (the
     job checks both).

     Before submitting, put in &extgen_dir; (see the entities below):
       the GiBUU tarball and the local products tarball of the mrb area
       (with uboonedata, for the tables).
-->

<!DOCTYPE project [
<!ENTITY release      "v08_00_00_98">
<!ENTITY qual         "e17:prof">
<!ENTITY user         "bbogart">
<!ENTITY name         "extgen_gibuu_test_10">
<!ENTITY extgen_dir   "/pnfs/uboone/resilient/users/bbogart/extgen">
<!ENTITY ext_samdef   "prod_extunbiased_swizzle_crt_inclusive_v7c_goodruns_mcc9_run4c_bnb_nuwro_overlay">
<!ENTITY gibuu_tar    "gibuu_scan.tar.gz">
<!ENTITY gibuu_md5    "363b4beee57efd6ecde56d8dedd3eb4a">  <!-- md5sum of gibuu_scan.tar.gz (build a4dbdba) -->
<!ENTITY nevents      "55">
<!ENTITY tables       "genie/gibuu/gibuu_2025p5_516d3a20">
]>

<job>

<project name="&name;">

  <numevents>-1</numevents>
  <os>SL7</os>
  <resource>DEDICATED,OPPORTUNISTIC</resource>

  <larsoft>
    <tag>&release;</tag>
    <qual>&qual;</qual>
    <local>&extgen_dir;/local_&release;.tar</local>
  </larsoft>

  <check>0</check>
  <copy>0</copy>
  <version>test_&release;</version>

  <stage name="gen_g4">

    <inputdef>&ext_samdef;</inputdef>

    <!-- steps A-D; files passed with jobsub -f are found in $CONDOR_DIR_INPUT -->
    <initscript>extgen_gibuu_grid_init.sh --stepa-fcl extgen_requests_bnb_run4c.fcl --nevents &nevents; --gibuu-tarball &extgen_dir;/&gibuu_tar; --gibuu-md5 &gibuu_md5; --tables &tables;</initscript>

    <fcl>extgen_overlay_SimInfoMixer.fcl</fcl>
    <fcl>wirecell_g4_uboone.fcl</fcl>

    <outdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/gen_g4</outdir>
    <logdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/gen_g4</logdir>
    <workdir>/pnfs/uboone/resilient/users/&user;/work/&release;/&name;/gen_g4</workdir>
    <bookdir>/pnfs/uboone/resilient/users/&user;/book/&release;/&name;/gen_g4</bookdir>

    <maxfilesperjob>1</maxfilesperjob>
    <numjobs>10</numjobs>
    <memory>4000</memory>
    <disk>20GB</disk>
    <datatier>simulated</datatier>
    <jobsub>--expected-lifetime=8h -e IFDH_CP_UNLINK_ON_ERROR=1 --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)&amp;&amp;(TARGET.HAS_CVMFS_uboone_osgstorage_org==true)' -f &extgen_dir;/&gibuu_tar;</jobsub>
    <jobsub_start>--expected-lifetime=8h --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)'</jobsub_start>
  </stage>

  <filetype>overlay</filetype>
  <runtype>physics</runtype>

</project>

</job>
