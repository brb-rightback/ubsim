<?xml version="1.0"?>

<!-- ExtGen GiBUU overlay, BNB run 4c: reco2 (MCC10), on the reco1 output of
     extgen_gibuu_bnb_run4c_reco1.xml. Workflow as the HepMC GiBUU production
     (v08_00_00_90/prod_hepmc/prod_gibuu/BNB/prod/prodgibuu_BNB_numuCC_overlay_run4c_reco2.xml),
     except the combined reco tree: ExtGen events carry GENIE's MCFlux and a
     GTruth updated by ExtGenMerge, so the standard GENIE-overlay
     run_combinedrecotree_overlay.fcl (picked per run period by
     pick_combinedrecotree_overlay.sh) is used instead of the _nuwro variant,
     which ignores both. FileType: def_filetype_extgen_gibuu_overlay.sh
     (given by absolute path: the v10 release does not have the ExtGen
     scripts).
-->

<!DOCTYPE project [
<!ENTITY release       "v10_04_07_26">
<!ENTITY qualifier     "e26:prof">
<!ENTITY user          "bbogart">
<!ENTITY name          "extgen_gibuu_bnb_run4c">
<!ENTITY stage_name    "reco2">
<!ENTITY input_samdef  "SET_ME_reco1_output_dataset">
<!ENTITY scripts       "/exp/uboone/data/users/bbogart/v08_00_00_98/srcs/ubsim/ubsim/ExtGen/xml">
<!ENTITY copy_number   "0">   <!-- 0 for testing, 1 for production -->
<!ENTITY numjobs       "20">  <!-- 20 for testing, then the number of reco1 files -->
]>

<job>

<project name="&name;_&stage_name;">

  <numevents>-1</numevents>
  <os>SL7</os>
  <resource>DEDICATED,OPPORTUNISTIC,OFFSITE</resource>

  <larsoft>
    <tag>&release;</tag>
    <qual>&qualifier;</qual>
  </larsoft>

  <check>1</check>
  <copy>&copy_number;</copy>
  <version>prod_&release;</version>

  <stage name="&stage_name;">

    <inputdef>&input_samdef;</inputdef>

    <fcl>
      copy_nonartroot.fcl
      <endscript>check_crt_merging.sh</endscript>
    </fcl>
    <fcl>
      crt_merge_extra_v06_26_01_13.fcl
      <initsource>crt_remerging.sh</initsource>
    </fcl>
    <fcl>wirecell_reg4_LightPropTime_LY.fcl</fcl>
    <fcl>wirecell_detsim_optical_overlay_uboone.fcl</fcl>
    <fcl>
      standard_overlay_optical_uboone.fcl
      <initsource>standard_overlay_optical_uboone.sh</initsource>
    </fcl>
    <fcl>
      run_celltreeub_overlay_port_prod.fcl
      <endscript>fully_unified_reco2_wirecell.sh</endscript>
    </fcl>
    <fcl>
      run_slimmed_port_overlay_sp.fcl
      <initsource>update_slimmed_port.sh</initsource>
    </fcl>
    <fcl>mcc10_dlreco_w_wirecell_driver_overlay_lantern_set1.fcl</fcl>
    <fcl>mcc10_dlreco_w_wirecell_driver_overlay_lantern_set2.fcl</fcl>
    <fcl>mcc10_dlreco_w_wirecell_driver_overlay_lantern_set3.fcl</fcl>
    <fcl>mcc10_dlreco_w_wirecell_driver_overlay_lantern_set4.fcl</fcl>
    <fcl>mcc10_dlreco_w_wirecell_driver_overlay_lantern_set5.fcl
      <endscript>merge_dlreco_fnal_overlay_and_mc_lantern_multiStage.sh</endscript>
    </fcl>
    <fcl>run_wcpplus_port_noreco1drop.fcl</fcl>
    <fcl>
      run_wcpf_port_noreco1drop.fcl
      <initsource>update_wcpf_port.sh</initsource>
    </fcl>
    <fcl>run_wirecellmcs.fcl</fcl>
    <fcl>reco_uboone_mcc9_8_driver_overlay_opfilter.fcl</fcl>
    <fcl>reco_uboone_mcc9_10_driver_overlay_stage2a.fcl</fcl>
    <fcl>reco_uboone_mcc9_10_driver_overlay_nugraph.fcl</fcl>
    <fcl>reco_uboone_mcc9_10_driver_overlay_stage2b.fcl</fcl>
    <fcl>run_fullshowerreco_overlay.fcl</fcl>
    <fcl>
      run_combinedrecotree_overlay.fcl
      <initsource>pick_combinedrecotree_overlay.sh</initsource>
      <initsource>&scripts;/def_filetype_extgen_gibuu_overlay.sh</initsource>
    </fcl>
    <fcl>
      define_metadata_lantern.fcl
      <endscript>pick_launch_lantern_container_mc_unified.sh</endscript>
      <endscript>check_config.py</endscript>
    </fcl>

    <outdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/&stage_name;/out</outdir>
    <logdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/&stage_name;/log</logdir>
    <workdir>/pnfs/uboone/resilient/users/&user;/work/&release;/&name;/&stage_name;</workdir>
    <schema>https</schema>
    <merge>1</merge>
    <anamerge>1</anamerge>
    <dropboxwait>4</dropboxwait>
    <datatier>reconstructed</datatier>
    <datafiletypes>root</datafiletypes>
    <prestagefraction>0.95</prestagefraction>
    <maxfilesperjob>1</maxfilesperjob>
    <numjobs>&numjobs;</numjobs>
    <memory>6000</memory>
    <disk>30GB</disk>
    <jobsub>--blacklist=UConn-HPC,Colorado,Lancaster --expected-lifetime=48h -e IFDH_CP_UNLINK_ON_ERROR=1 --subgroup=prod --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)&amp;&amp;(TARGET.HAS_CVMFS_uboone_osgstorage_org==true)' -e LC_ALL=C -e IFDH_FORCE=https -e IFDH_CP_MAXRETRIES=5 -e IFDH_HTTPS_EXTRA=-f</jobsub>
    <jobsub_start>--subgroup=prod --expected-lifetime=48h --site=FermiGrid --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)'</jobsub_start>
  </stage>

  <filetype>overlay</filetype>
  <runtype>physics</runtype>

</project>
</job>
