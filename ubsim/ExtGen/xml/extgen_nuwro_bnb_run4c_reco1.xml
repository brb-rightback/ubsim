<?xml version="1.0"?>

<!-- ExtGen NuWro overlay, BNB run 4c: production through reco1.
     The NuWro counterpart of extgen_gibuu_bnb_run4c_reco1.xml; only the
     generator part differs. Each job takes one run-4c EXT file and runs
       extgen_nuwro_grid_init.sh, nevents auto (initscript): setup, checks:
                                  NuWro tarball and its e26 environment,
                                  tables, seeds
       extgen_ext_copy.fcl        copies the EXT file into the job; its
                                  endscript extgen_nuwro_grid_continue.sh
                                  counts its events N and runs steps A-D
                                  (N GENIE requests with NuWro cross sections,
                                  tune NW25_11a_00_000; NuWro final states;
                                  merge)
                                  -> genfile.root.local with N events
       extgen_overlay_SimInfoMixer.fcl, then the standard run-4c overlay chain:
       g4, detsim, overlay, reco1 stages 1a/1b/1c.

     NuWro runs with the e26 ROOT/Pythia6 of its build, set up from the
     larsoft CVMFS repository (extgen_nuwro_run.sh), hence the extra
     condor requirement.

     Before submitting:
       * put the NuWro tarball (make_nuwro_tarball.sh) and the local products
         tarball of the mrb area (with ubsim and uboonedata, i.e. the tables
         genie/nuwro/) in &extgen_dir;;
       * set numjobs (one EXT file per job).
     Every job keeps its seeds, requests, served events and the in-job cross
     section check (V4) in its log tarball.
-->

<!DOCTYPE project [
<!ENTITY release      "v08_00_00_98">
<!ENTITY qual         "e17:prof">
<!ENTITY user         "bbogart">
<!ENTITY name         "extgen_nuwro_bnb_run4c_test_reco1">  <!-- production: extgen_nuwro_bnb_run4c -->
<!ENTITY extgen_dir   "/pnfs/uboone/resilient/users/bbogart/extgen">
<!ENTITY ext_samdef   "prod_extunbiased_swizzle_crt_inclusive_v7c_goodruns_mcc9_run4c_bnb_nuwro_overlay">
<!ENTITY nuwro_tar    "nuwro_extgen.tar.gz">
<!ENTITY nuwro_md5    "01f6a301c9abeb029b25077a65334607">  <!-- md5sum of nuwro_extgen.tar.gz (build 32065e3) -->
<!ENTITY tables       "genie/nuwro/nuwro_25_11_1_0bbe5a54">
<!ENTITY numjobs      "10">   <!-- test; production: number of EXT files -->
]>

<job>

<project name="&name;_reco1">

  <numevents>-1</numevents>
  <os>SL7</os>
  <resource>DEDICATED,OPPORTUNISTIC,OFFSITE</resource>

  <larsoft>
    <tag>&release;</tag>
    <qual>&qual;</qual>
    <local>&extgen_dir;/local_&release;.tar</local>
  </larsoft>

  <check>0</check>
  <copy>0</copy>
  <version>prod_&release;</version>

  <stage name="reco1">

    <inputdef>&ext_samdef;</inputdef>

    <!-- setup for steps A-D; files passed with jobsub -f are found in $CONDOR_DIR_INPUT -->
    <initscript>extgen_nuwro_grid_init.sh --stepa-fcl extgen_requests_nuwro_bnb_run4c.fcl --nevents auto --nuwro-tarball &extgen_dir;/&nuwro_tar; --nuwro-md5 &nuwro_md5; --tables &tables; --soft-fail</initscript>

    <!-- EXT file into the job, then steps A-D with N = its events -->
    <fcl>extgen_ext_copy.fcl
      <endscript>extgen_nuwro_grid_continue.sh</endscript>
    </fcl>
    <fcl>extgen_overlay_SimInfoMixer.fcl</fcl>
    <fcl>wirecell_g4_uboone.fcl</fcl>
    <fcl>wirecell_detsim_overlay_uboone.fcl</fcl>
    <fcl>standard_overlay_uboone.fcl</fcl>
    <fcl>reco_uboone_mcc9_8_driver_overlay_stage1a.fcl</fcl>
    <fcl>reco_uboone_mcc9_8_driver_overlay_stage1b.fcl</fcl>
    <fcl>reco_uboone_mcc9_8_driver_overlay_stage1c.fcl</fcl>

    <outdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/reco1</outdir>
    <logdir>/pnfs/uboone/scratch/users/&user;/&release;/&name;/reco1</logdir>
    <workdir>/pnfs/uboone/resilient/users/&user;/work/&release;/&name;/reco1</workdir>
    <bookdir>/pnfs/uboone/resilient/users/&user;/book/&release;/&name;/reco1</bookdir>

    <maxfilesperjob>1</maxfilesperjob>
    <numjobs>&numjobs;</numjobs>
    <memory>5000</memory>   <!-- GiBUU reco1 test: peak RSS 3.49 GB (reco1a) -->
    <disk>35GB</disk>
    <prestagefraction>0.99</prestagefraction>
    <datatier>reconstructed</datatier>
    <jobsub>--expected-lifetime=12h -e IFDH_CP_UNLINK_ON_ERROR=1 --subgroup=prod --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)&amp;&amp;(TARGET.HAS_CVMFS_uboone_osgstorage_org==true)&amp;&amp;(TARGET.HAS_CVMFS_larsoft_opensciencegrid_org==true)' -f &extgen_dir;/&nuwro_tar;</jobsub>
    <jobsub_start>--subgroup=prod --expected-lifetime=12h --append_condor_requirements='(TARGET.HAS_CVMFS_uboone_opensciencegrid_org==true)'</jobsub_start>
  </stage>

  <filetype>overlay</filetype>
  <runtype>physics</runtype>

</project>

</job>
